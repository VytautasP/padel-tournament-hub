{
  "name": "padel-tournament-hub",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "build": "ng build padel-engine && ng build padel-app",
    "test": "ng test padel-engine --watch=false && ng test padel-app --watch=false",
    "lint": "ng lint",
    "format": "prettier --write \"**/*.{ts,js,mjs,json,html,css}\"",
    "format:check": "prettier --check \"**/*.{ts,js,mjs,json,html,css}\"",
    "verify:boundary": "node tools/verify-engine-boundary.mjs",
    "print:schedule": "npm run build && node tools/print-schedule.mjs",
    "verify": "npm run format:check && npm run lint && npm run verify:boundary && npm run verify:conventions && npm run build && npm test",
    "start": "ng serve padel-app",
    "verify:conventions": "node tools/verify-app-conventions.mjs"
  },
  "private": true,
  "packageManager": "npm@11.17.0",
  "dependencies": {
    "@angular/cdk": "^22.1.4",
    "@angular/common": "^22.1.3",
    "@angular/compiler": "^22.1.3",
    "@angular/core": "^22.1.3",
    "@angular/platform-browser": "^22.1.3",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.5",
    "@angular/cli": "^22.1.5",
    "@angular/compiler-cli": "^22.1.3",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "angular-eslint": "22.1.0",
    "eslint": "^10.3.0",
    "jsdom": "^28.0.0",
    "ng-packagr": "^22.1.1",
    "postcss": "^8.5.26",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.59.2",
    "vitest": "^4.0.8"
  }
}
